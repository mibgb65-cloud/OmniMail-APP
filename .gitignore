# ===== GIT 忽略规则 =====
# 详见 docs/00-guidelines/git-conventions.md §5

# --- 凭据与密钥（绝不入库）---
*.pem
*.key
*.p12
*.pfx
token.json
.env
.env.*
!.env.example
secrets/

# --- 构建产物 ---
desktop/build/bin/
desktop/bin/
desktop/.task/
desktop/.devdata/
desktop/frontend/dist/
desktop/frontend/coverage/
desktop/frontend/*.tsbuildinfo
desktop/frontend/.bindings-tmp-*/
desktop/wails_*.syso
build-output/
dist/

# --- 依赖 ---
node_modules/
vendor/

# --- 本地数据与日志 ---
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log
coverage.out
coverage.html

# --- 测试与临时 ---
testdata/schema_v*.db
*.tmp
*.bak
*.corrupt-*

# --- 编辑器与系统 ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
